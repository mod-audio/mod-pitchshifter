@prefix lv2:  <http://lv2plug.in/ns/lv2core#>.
@prefix pset: <http://lv2plug.in/ns/ext/presets#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

<http://moddevices.com/plugins/mod-devel/PolyOctaver#preset-organ>
    a pset:Preset;
    lv2:appliesTo <http://moddevices.com/plugins/mod-devel/PolyOctaver>;
    rdfs:label "Organ";
    lv2:port [ lv2:symbol "Dry"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Sub2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Sub1"; pset:value 70.0 ];
    lv2:port [ lv2:symbol "Up1"; pset:value 70.0 ];
    lv2:port [ lv2:symbol "Up2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Attack"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Filter"; pset:value 20000.0 ];
    lv2:port [ lv2:symbol "Resonance"; pset:value 0.7 ];
    lv2:port [ lv2:symbol "Detune"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "DryFX"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Tracking"; pset:value 1.0 ].

<http://moddevices.com/plugins/mod-devel/PolyOctaver#preset-twelve-string>
    a pset:Preset;
    lv2:appliesTo <http://moddevices.com/plugins/mod-devel/PolyOctaver>;
    rdfs:label "Twelve-String";
    lv2:port [ lv2:symbol "Dry"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Sub2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Sub1"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Up1"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Up2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Attack"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Filter"; pset:value 12000.0 ];
    lv2:port [ lv2:symbol "Resonance"; pset:value 0.7 ];
    lv2:port [ lv2:symbol "Detune"; pset:value 6.0 ];
    lv2:port [ lv2:symbol "DryFX"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Tracking"; pset:value 1.0 ].

<http://moddevices.com/plugins/mod-devel/PolyOctaver#preset-sub-bass>
    a pset:Preset;
    lv2:appliesTo <http://moddevices.com/plugins/mod-devel/PolyOctaver>;
    rdfs:label "Sub Bass";
    lv2:port [ lv2:symbol "Dry"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Sub2"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Sub1"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Up1"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Up2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Attack"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Filter"; pset:value 2000.0 ];
    lv2:port [ lv2:symbol "Resonance"; pset:value 0.7 ];
    lv2:port [ lv2:symbol "Detune"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "DryFX"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Tracking"; pset:value 2.0 ].

<http://moddevices.com/plugins/mod-devel/PolyOctaver#preset-swell-pad>
    a pset:Preset;
    lv2:appliesTo <http://moddevices.com/plugins/mod-devel/PolyOctaver>;
    rdfs:label "Swell Pad";
    lv2:port [ lv2:symbol "Dry"; pset:value 100.0 ];
    lv2:port [ lv2:symbol "Sub2"; pset:value 0.0 ];
    lv2:port [ lv2:symbol "Sub1"; pset:value 90.0 ];
    lv2:port [ lv2:symbol "Up1"; pset:value 90.0 ];
    lv2:port [ lv2:symbol "Up2"; pset:value 50.0 ];
    lv2:port [ lv2:symbol "Attack"; pset:value 600.0 ];
    lv2:port [ lv2:symbol "Filter"; pset:value 5000.0 ];
    lv2:port [ lv2:symbol "Resonance"; pset:value 1.2 ];
    lv2:port [ lv2:symbol "Detune"; pset:value 10.0 ];
    lv2:port [ lv2:symbol "DryFX"; pset:value 1.0 ];
    lv2:port [ lv2:symbol "Tracking"; pset:value 2.0 ].
